# Dockerfile.wav2lip
FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime

WORKDIR /app

# Instalacija sistemskih zavisnosti
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1-mesa-glx \
    git \
    && rm -rf /var/lib/apt/lists/*

# Instalacija Python zavisnosti za Wav2Lip i FastAPI
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    python-multipart \
    requests \
    opencv-python \
    librosa \
    numba \
    tqdm

# Kopiranje koda servera i Wav2Lip fajlova
# Napomena: Checkpointi (wav2lip_gan.pth) treba da budu mapirani kroz volume ili pre-downloadovani
COPY . .

EXPOSE 8000

CMD ["uvicorn", "wav2lip_server:app", "--host", "0.0.0.0", "--port", "8000"]
